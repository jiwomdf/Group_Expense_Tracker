# Firebase options used to pre-fill the "Firebase options setting" form.
# Copy this file to `assets/env/.env` and fill in the values from your
# Firebase console. `.env` is git ignored, never commit it.

FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_DOMAIN=

# Android
FIREBASE_ANDROID_APP_ID=

# iOS
FIREBASE_IOS_BUNDLE_ID=

# Web
FIREBASE_WEB_APP_ID=
FIREBASE_MEASUREMENT_ID=
